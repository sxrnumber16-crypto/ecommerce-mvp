{
  "name": "ecommerce-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "deploy:start": "cp prisma/schema.mysql.prisma prisma/schema.prisma && npx prisma generate && npx prisma db push && npm run build && npm run seed && node dist/index.js",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "admin:create": "tsx prisma/admin-create.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "argon2": "^0.41.1",
    "cors": "^2.8.5",
    "express": "5.2.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.0.0",
    "tsx": "^4.16.0",
    "typescript": "5.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
